<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.csc311_mod3_lab2.LandingController"
            prefWidth="800"
            prefHeight="500"
            styleClass="landing-root">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="top-bar">

            <padding>
                <Insets top="15"
                        right="25"
                        bottom="15"
                        left="25"/>
            </padding>

            <Label text="CSC311 App"
                   styleClass="app-title"/>

            <Label text="Home"
                   styleClass="nav-text"/>

        </HBox>
    </top>

    <center>
        <StackPane>

            <VBox alignment="CENTER"
                  spacing="18"
                  maxWidth="430"
                  styleClass="landing-card">

                <padding>
                    <Insets top="35"
                            right="45"
                            bottom="35"
                            left="45"/>
                </padding>

                <Label text="Welcome!"
                       styleClass="landing-title"/>

                <Label text="You have successfully logged in."
                       styleClass="landing-text"/>

                <Label text="This is your main landing screen."
                       styleClass="landing-text"/>

                <Button text="Get Started"
                        maxWidth="220"
                        styleClass="primary-button"/>

            </VBox>

        </StackPane>
    </center>

</BorderPane>